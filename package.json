{
  "name": "fadipsaati.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "pnpm build && wrangler dev",
    "check": "astro check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "links": "linkinator dist --recurse --skip \"^https?://(?!fadipsaati\\.com)\"",
    "deploy:manual": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^5.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "linkinator": "^6.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
