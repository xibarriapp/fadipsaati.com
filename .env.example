# Copy to `.env` (never commit it). Used by local scripts and wrangler CLI.
# Real values live in: your local .env, GitHub → Settings → Secrets → Actions,
# and Cloudflare → Workers → fadipsaati → Settings → Variables (secrets).

# Cloudflare (CI deploys; locally only needed to run `pnpm deploy:manual`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
